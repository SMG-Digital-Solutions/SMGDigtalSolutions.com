# Only needed for local development, and only if you're running the
# companion admin app's Next.js dev server directly (e.g. localhost:3000)
# instead of going through the Netlify proxy. Leave unset in production.
#
# Used by two different callers: client-side lead submission (leadsApi.ts)
# falls back to a relative URL when unset (same-origin through the /admin
# proxy rewrite — see netlify.toml). The build-time CMS content fetch
# (content.ts, used by every `astro build`) falls back to the full
# production URL instead, since Node's `fetch` has no "current page origin"
# to resolve a relative URL against.
PUBLIC_ADMIN_ORIGIN="http://localhost:3000"
