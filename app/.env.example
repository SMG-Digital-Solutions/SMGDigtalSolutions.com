# Only needed for local development, and only if you're running the
# companion admin app's Next.js dev server directly (e.g. localhost:3000)
# instead of going through the Netlify proxy. Leave unset in production —
# requests to the admin API are same-origin through the /admin proxy rewrite
# (see netlify.toml), so a relative URL is correct there.
PUBLIC_ADMIN_ORIGIN="http://localhost:3000"
