---
import { Image } from 'astro:assets';
import { ArrowRight, ChartLineUp, Cpu, GlobeHemisphereWest, RocketLaunch, ShieldCheck, Sparkle } from '@phosphor-icons/react';
import DemoButton from '../components/DemoButton';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import Services from '../components/Services.astro';
import logo from '../assets/Logo-Removed-Background.svg';

const services = [
  {
    title: 'Conversion-first architecture',
    description: 'High-speed landing pages and service sites engineered to turn visits into qualified leads.',
    icon: RocketLaunch,
  },
  {
    title: 'Local visibility strategy',
    description: 'SEO-friendly structure, geotargeted messaging, and performance tuning for Florida and the USVI.',
    icon: GlobeHemisphereWest,
  },
  {
    title: 'Operational automation',
    description: 'CRM-ready lead flows, analytics, and follow-up systems that scale without friction.',
    icon: Cpu,
  },
];

const outcomes = [
  'Mobile-first pages that win trust instantly',
  'Lightning-fast load times for better retention',
  'Clear CTAs that move buyers to action',
];
---

<Layout>
  <Fragment slot="head">
    <link rel="preload" as="image" href={logo.src} />
  </Fragment>
  <div id="top" class="min-h-screen bg-[#F7F7F7] text-[#121212] transition-colors duration-200 dark:bg-[#121212] dark:text-[#F7F7F7]">
    <header class="w-full">
      <nav class="w-full bg-[#00416A] dark:bg-[#072938] text-white shadow-sm" aria-label="Primary navigation">
        <div class="shell mx-auto flex items-center justify-between gap-4 px-4 py-3">
          <a href="/" class="flex items-center gap-4">
            <div class="flex h-12 max-w-[190px] items-center">
              <Image src={logo} alt="SMG Digital Solutions" width={180} height={48} class="h-full w-auto object-contain" />
            </div>
          </a>
          <Navigation client:load />
        </div>
      </nav>
    </header>

    <main>
      <section class="relative overflow-hidden" aria-labelledby="hero-heading">
        <div class="pointer-events-none absolute inset-x-0 top-0 h-80 bg-[radial-gradient(circle_at_top,_rgba(0,180,255,0.18),transparent_42%)]"></div>
        <div class="pointer-events-none absolute right-0 top-12 hidden h-[420px] w-[420px] translate-x-1/3 rounded-full bg-[#38bdf8]/10 blur-3xl lg:block"></div>
        <div class="shell rounded-[2rem] bg-[#071925] px-6 py-16 text-white shadow-[0_30px_120px_rgba(0,0,0,0.25)] dark:bg-transparent dark:rounded-none dark:shadow-none">
          <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
            <div class="mx-auto flex max-w-3xl flex-col gap-8 lg:mx-0">
            <!-- badge removed per request -->
            <div class="space-y-5">
              <h1 id="hero-heading" class="max-w-3xl text-3xl font-black leading-[1.05] tracking-tight text-white sm:text-4xl lg:text-[3.75rem]">
                Stop losing customers to your competitors.
                <span class="block text-[#008C9E] dark:text-[#4CAF50] text-xl">Get a high-converting web asset built to capture leads 24/7.</span>
              </h1>
              <p class="max-w-2xl text-base leading-7 text-white/70">
                SMG Digital Solutions creates speed-first websites that turn local visibility into qualified demand for businesses across Florida and the USVI.
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <DemoButton client:load />
              <a href="#results" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/20" aria-label="Explore the expected business outcomes">
                See what we optimize
                <ArrowRight size={18} weight="bold" />
              </a>
            </div>
            <!-- Core growth outcome chips removed per user request -->
          </div>

          <!-- Primary brand asset section removed per user request -->
        </div>
      </section>

      <section id="services" class="shell py-8" aria-labelledby="services-heading">
        <div class="rounded-[2rem] border border-black/10 bg-white/80 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-[#1A2B3C]/70">
          <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#008C9E] dark:text-[#4CAF50]">Service focus</p>
              <h2 id="services-heading" class="mt-2 text-3xl font-black tracking-tight text-[#121212] dark:text-[#F7F7F7]">A modular growth system built around your message.</h2>
            </div>
            <p class="max-w-xl text-base leading-7 text-[#3f4b5a] dark:text-[#d5dde4]">Every engagement balances content strategy, page speed, and conversion design so your site earns trust quickly and moves prospects forward.</p>
          </div>
            <div class="grid gap-4 md:grid-cols-3">
            {services.map((service) => {
              const Icon = service.icon;
              return (
                <article class="glass-card rounded-[1.4rem] border border-black/10 bg-[#F7F7F7] p-5 shadow-sm dark:border-white/10 dark:bg-[#121212]">
                  <div class="mb-4 inline-flex rounded-full bg-[#008C9E]/10 p-3 text-[#008C9E] dark:bg-[#4CAF50]/10 dark:text-[#4CAF50]">
                    <Icon size={20} weight="bold" />
                  </div>
                  <h3 class="text-lg font-semibold text-[#121212] dark:text-[#F7F7F7]">{service.title}</h3>
                  <p class="mt-2 text-sm leading-7 text-[#3f4b5a] dark:text-[#d5dde4]">{service.description}</p>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <!-- Pricing and Packages -->
      <Services />

      <section id="results" class="shell py-8" aria-labelledby="results-heading">
        <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
          <div class="rounded-[2rem] border border-black/10 bg-[#00416A] p-6 text-white shadow-[0_18px_50px_rgba(0,65,106,0.2)] dark:border-white/10 dark:bg-[#1A2B3C]">
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-white/70">Why it converts</p>
            <h2 id="results-heading" class="mt-3 text-3xl font-black tracking-tight">Every section is designed to reduce friction and increase confidence.</h2>
            <div class="mt-8 space-y-4">
              {outcomes.map((outcome, i) => (
                <div class="glass-card flex items-start gap-3 rounded-2xl bg-white/10 p-3" key={i}>
                  <ShieldCheck size={20} weight="fill" className="mt-0.5 shrink-0" />
                  <p class="text-sm leading-7 text-white/90">{outcome}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-[2rem] border border-black/10 bg-white/80 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-[#1A2B3C]/70">
            <div class="mb-6 flex items-center gap-3 text-[#008C9E] dark:text-[#4CAF50]">
              <ChartLineUp size={24} weight="bold" />
              <p class="text-sm font-semibold uppercase tracking-[0.25em]">Growth metrics</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {[
                { value: '2.3x', label: 'Higher lead capture on conversion-focused pages' },
                { value: '94+', label: 'Performance score on core landing experiences' },
                { value: '24/7', label: 'Visible call-to-action flow for every visitor' },
                { value: '100%', label: 'Accessible, semantic structure for every build' },
              ].map((item) => (
                <article class="rounded-[1.2rem] border border-black/10 bg-[#F7F7F7] p-4 dark:border-white/10 dark:bg-[#121212]">
                  <p class="text-3xl font-black text-[#008C9E] dark:text-[#4CAF50]">{item.value}</p>
                  <p class="mt-2 text-sm leading-7 text-[#3f4b5a] dark:text-[#d5dde4]">{item.label}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="shell py-8" aria-labelledby="final-cta-heading">
        <div class="rounded-[2rem] border border-black/10 bg-white/80 p-8 text-center shadow-sm backdrop-blur dark:border-white/10 dark:bg-[#1A2B3C]/70">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#008C9E] dark:text-[#4CAF50]">Ready to launch</p>
          <h2 id="final-cta-heading" class="mt-3 text-3xl font-black tracking-tight text-[#121212] dark:text-[#F7F7F7]">Let’s turn your next customer visit into a booked conversation.</h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-[#3f4b5a] dark:text-[#d5dde4]">Use the CTA below to open a secure demo request and start the conversation with a team that builds for speed, clarity, and revenue.</p>
          <div class="mt-8 flex justify-center">
            <DemoButton client:load />
          </div>
        </div>
      </section>

      <section id="contact" class="shell py-16" aria-labelledby="contact-heading">
        <div class="mx-auto max-w-5xl rounded-[2rem] border border-black/10 bg-white/80 p-8 shadow-sm backdrop-blur dark:border-white/10 dark:bg-[#1A2B3C]/70">
          <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#008C9E] dark:text-[#4CAF50]">Contact us</p>
              <h2 id="contact-heading" class="mt-3 text-3xl font-black tracking-tight text-[#121212] dark:text-[#F7F7F7]">Have a project in mind? Let’s talk.</h2>
              <p class="mt-4 max-w-2xl text-base leading-7 text-[#3f4b5a] dark:text-[#d5dde4]">Fill out the form and we’ll follow up with a fast, transparent quote that fits your local business goals.</p>
            </div>
            <form class="space-y-4 rounded-[1.5rem] border border-black/10 bg-[#F7F7F7]/90 p-6 dark:border-white/10 dark:bg-[#0F1B2C]/80" action="https://formsubmit.co/your-email@example.com" method="POST">
              <input type="hidden" name="_subject" value="New contact form submission" />
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-semibold text-[#121212] dark:text-[#F7F7F7]">
                  Name
                  <input type="text" name="name" required class="mt-2 w-full rounded-3xl border border-black/10 bg-white px-4 py-3 text-sm text-[#121212] outline-none transition focus:border-[#008C9E] focus:ring-2 focus:ring-[#008C9E]/20 dark:border-white/10 dark:bg-[#122238] dark:text-[#F7F7F7]" />
                </label>
                <label class="block text-sm font-semibold text-[#121212] dark:text-[#F7F7F7]">
                  Email
                  <input type="email" name="email" required class="mt-2 w-full rounded-3xl border border-black/10 bg-white px-4 py-3 text-sm text-[#121212] outline-none transition focus:border-[#008C9E] focus:ring-2 focus:ring-[#008C9E]/20 dark:border-white/10 dark:bg-[#122238] dark:text-[#F7F7F7]" />
                </label>
              </div>
              <label class="block text-sm font-semibold text-[#121212] dark:text-[#F7F7F7]">
                Message
                <textarea name="message" rows="5" required class="mt-2 w-full rounded-[1.5rem] border border-black/10 bg-white px-4 py-3 text-sm text-[#121212] outline-none transition focus:border-[#008C9E] focus:ring-2 focus:ring-[#008C9E]/20 dark:border-white/10 dark:bg-[#122238] dark:text-[#F7F7F7]"></textarea>
              </label>
              <button type="submit" class="inline-flex w-full justify-center rounded-full bg-[#008C9E] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#006a73] dark:bg-[#4CAF50] dark:hover:bg-[#379d55]">Send message</button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="shell pb-10 pt-2">
      <div class="flex flex-col gap-3 border-t border-black/10 pt-6 text-sm text-[#3f4b5a] dark:border-white/10 dark:text-[#d5dde4] sm:flex-row sm:items-center sm:justify-between">
        <p>SMG Digital Solutions • Florida & USVI</p>
        <a href="https://tally.so/r/n0kQ9N" class="font-semibold text-[#008C9E] transition hover:text-[#006a73] dark:text-[#4CAF50]" aria-label="Open the secure demo request form">Request a custom demo</a>
      </div>
    </footer>
  </div>
</Layout>
