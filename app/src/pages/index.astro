---
import { Image } from 'astro:assets';
import { ArrowRight, RocketLaunch, ShieldCheck, Sparkle, InstagramLogo, LinkedinLogo, FacebookLogo } from '@phosphor-icons/react';
import DemoButton from '../components/DemoButton';
import HeroFloatingCard from '../components/HeroFloatingCard';
import TypedHeadline from '../components/TypedHeadline';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import Services from '../components/Services.astro';
import ScrollRevealImmediate from '../components/ScrollRevealImmediate';
import ScrollRevealStagger from '../components/ScrollRevealStagger';
import logo from '../assets/Logo-Removed-Background.svg';

const services = [
  {
    title: 'Conversion-First Architecture',
    description: 'High-speed landing pages and websites engineered for high-conversion of visitors to leads.',
    icon: RocketLaunch,
  },
  {
    title: 'Strategic Growth Design',
    description: 'SEO-optimized architecture and precision-tuned messaging designed to put your business in front of your ideal audience.',
    icon: Sparkle,
  },
  {
    title: 'Optimized Performance & Architectural Integrity',
    description: 'Engineered for maximum uptime and lightning-fast load times, every site is manually reviewed to ensure it serves as a robust, professional digital asset ready for growth.',
    icon: ShieldCheck,
  },
];
---

<Layout>
  <Fragment slot="head">
    <link rel="preload" as="image" href={logo.src} />
  </Fragment>
  <div id="top" class="min-h-screen bg-[#F7F7F7] text-[#121212] transition-colors duration-200 dark:bg-[#121212] dark:text-[#F7F7F7]">
    <header class="w-full">
      <nav class="w-full bg-[#00416A] dark:bg-[#072938] text-white shadow-sm" aria-label="Primary navigation">
        <div class="shell mx-auto flex items-center justify-between gap-4 px-4 py-3">
          <a href="/" class="flex items-center gap-4">
            <div class="flex h-12 max-w-[190px] items-center">
              <Image src={logo} alt="SMG Digital Solutions" width={180} height={48} class="h-full w-auto object-contain" />
            </div>
          </a>
          <Navigation client:idle />
        </div>
      </nav>
    </header>

    <main>
      <section class="relative overflow-hidden" aria-labelledby="hero-heading">
        <div aria-hidden="true" class="hero-blob hero-blob-a"></div>
        <div aria-hidden="true" class="hero-blob hero-blob-b"></div>
        <div aria-hidden="true" class="hero-blob hero-blob-c"></div>
        <div aria-hidden="true" class="hero-mesh"></div>
        <div aria-hidden="true" class="hero-mesh-orbit"></div>
        <div class="relative z-10 w-full bg-[#F7F7F7]/10 dark:bg-[#071925]/70 px-6 py-12 text-[#121212] dark:text-white shadow-[0_30px_120px_rgba(0,0,0,0.08)] dark:shadow-[0_30px_120px_rgba(0,0,0,0.25)] backdrop-blur-sm dark:backdrop-blur-md lg:flex lg:min-h-[76vh] lg:items-center lg:py-16">
          <div class="mx-auto grid w-full max-w-6xl gap-6 lg:grid-cols-2 lg:items-center">
            <div class="flex flex-col gap-8">
              <!-- badge removed per request -->
              <div class="space-y-6 lg:space-y-8">
                <ScrollRevealImmediate client:visible threshold={0.3}>
                  <h1 id="hero-heading" class="hero-stagger-0 text-3xl font-black leading-[1.08] tracking-tight text-[#121212] dark:text-white sm:text-4xl lg:text-[3.75rem] lg:leading-[1.1]">
                    <TypedHeadline
                      client:visible
                      staticText="Stop losing customers to your "
                      typedText="competitors."
                    />
                    <span class="mt-5 block text-xl lg:mt-6 lg:text-2xl text-[#008C9E] dark:text-[#4CAF50]">Get a high-converting web asset built to capture leads 24/7.</span>
                  </h1>
                </ScrollRevealImmediate>
                <p class="hero-stagger-1 max-w-2xl text-base leading-7 text-[#4b5563] dark:text-white/70 drop-shadow-sm">
                  SMG Digital Solutions creates speed-first websites that turn visitors into actionable leads for growing businesses.
                </p>
              </div>
              <div class="hero-stagger-2 flex flex-wrap items-center gap-3">
                <DemoButton client:visible />
                <a href="#packages" class="cta-secondary inline-flex items-center gap-2 rounded-full border border-[#121212]/15 bg-[#121212]/5 px-5 py-3 text-sm font-semibold text-[#121212] transition hover:bg-[#121212]/10 dark:border-white/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/20" aria-label="View our pricing and service packages">
                  See what we optimize
                  <ArrowRight size={18} weight="bold" aria-hidden="true" />
                </a>
              </div>
              <!-- Core growth outcome chips removed per user request -->
            </div>

            {/* Floating Card - responsive on all screens */}
            <div class="hero-stagger-3 flex lg:justify-end justify-start lg:mt-0 mt-8">
              <HeroFloatingCard client:visible />
            </div>
        </div>
      </section>

      <section id="services" class="shell py-8" aria-labelledby="services-heading">
        <div class="rounded-[2rem] border border-black/10 bg-white/80 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-[#1A2B3C]/70">
          <div class="mb-12 lg:mb-14">
            <div class="max-w-4xl space-y-4">
              <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#008C9E] dark:text-[#4CAF50]">Service focus</p>
              <h2 id="services-heading" class="text-xl font-black leading-[1.15] tracking-tight text-[#121212] dark:text-[#F7F7F7] md:text-[1.65rem] lg:text-[1.8rem]">AI-Powered Digital Solutions for Businesses at All Stages</h2>
              <p class="max-w-3xl text-base leading-7 text-[#4b5563] dark:text-[#d5dde4]">Stop settling for slow, one-size-fits-all platforms. We combine AI-driven development with human strategy to build custom, high-performance websites that capture leads and scale your brand.</p>
            </div>
          </div>
            <ScrollRevealStagger client:visible staggerDelay={100} threshold={0.2}>
              <div class="grid gap-4 md:grid-cols-3">
                {services.map((service) => {
                  const Icon = service.icon;
                  return (
                    <article class="p-1">
                      <div class="mb-4 inline-flex text-[#008C9E] dark:text-[#4CAF50]">
                        <Icon size={20} weight="bold" />
                      </div>
                      <h3 class="text-lg font-semibold text-[#121212] dark:text-[#F7F7F7]">{service.title}</h3>
                      <p class="mt-2 text-sm leading-7 text-[#4b5563] dark:text-[#d5dde4]">{service.description}</p>
                    </article>
                  );
                })}
              </div>
            </ScrollRevealStagger>
          </div>
      </section>

      <!-- Pricing and Packages -->
      <Services />

      <section class="shell py-8" aria-labelledby="final-cta-heading">
        <div class="rounded-[2rem] border border-black/10 bg-white/80 p-8 text-center shadow-sm backdrop-blur dark:border-white/10 dark:bg-[#1A2B3C]/70">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#008C9E] dark:text-[#4CAF50]">Ready to launch</p>
          <h2 id="final-cta-heading" class="mt-3 text-3xl font-black tracking-tight text-[#121212] dark:text-[#F7F7F7]">Let’s turn your next customer visit into a booked conversation.</h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-[#4b5563] dark:text-[#d5dde4]">Click the button below request a demo and start the conversation with a team that builds for speed, clarity, and revenue.</p>
          <div class="mt-8 flex justify-center">
            <DemoButton client:idle />
          </div>
        </div>
      </section>

      <section id="contact" class="shell flex items-center justify-center py-16" aria-labelledby="contact-heading">
        <div class="mx-auto max-w-5xl rounded-[2rem] border border-black/10 bg-white/80 p-8 shadow-sm backdrop-blur dark:border-white/10 dark:bg-[#1A2B3C]/70">
          <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#008C9E] dark:text-[#4CAF50]">Contact us</p>
              <h2 id="contact-heading" class="mt-3 text-3xl font-black tracking-tight text-[#121212] dark:text-[#F7F7F7]">Need a custom quote? Let’s talk.</h2>
              <p class="mt-4 max-w-2xl text-base leading-7 text-[#4b5563] dark:text-[#d5dde4]">Fill out the form and we’ll follow up with a fast, transparent quote that fits your local business goals.</p>
            </div>
            <form class="min-h-96 lg:min-h-[28rem] space-y-4 rounded-[1.5rem] border border-black/10 bg-[#F7F7F7]/90 p-6 dark:border-white/10 dark:bg-[#0F1B2C]/80" action="https://formsubmit.co/smgdigitalsolutions@outlook.com" method="POST">
              <input type="hidden" name="_subject" value="New contact form submission" />
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-semibold text-[#121212] dark:text-[#F7F7F7]">
                  Name
                  <input type="text" name="name" required class="mt-2 w-full rounded-3xl border border-black/10 bg-white px-4 py-3 text-sm text-[#121212] outline-none transition focus:border-[#008C9E] focus:ring-2 focus:ring-[#008C9E]/20 dark:border-white/10 dark:bg-[#122238] dark:text-[#F7F7F7]" />
                </label>
                <label class="block text-sm font-semibold text-[#121212] dark:text-[#F7F7F7]">
                  Email
                  <input type="email" name="email" required class="mt-2 w-full rounded-3xl border border-black/10 bg-white px-4 py-3 text-sm text-[#121212] outline-none transition focus:border-[#008C9E] focus:ring-2 focus:ring-[#008C9E]/20 dark:border-white/10 dark:bg-[#122238] dark:text-[#F7F7F7]" />
                </label>
              </div>
              <label class="block text-sm font-semibold text-[#121212] dark:text-[#F7F7F7]">
                Message
                <textarea name="message" rows="5" required class="mt-2 w-full rounded-[1.5rem] border border-black/10 bg-white px-4 py-3 text-sm text-[#121212] outline-none transition focus:border-[#008C9E] focus:ring-2 focus:ring-[#008C9E]/20 dark:border-white/10 dark:bg-[#122238] dark:text-[#F7F7F7]"></textarea>
              </label>
              <button type="submit" class="inline-flex w-full justify-center rounded-full bg-[#008C9E] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#006a73] dark:bg-[#4CAF50] dark:hover:bg-[#379d55]">Send message</button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-[#0A1419] dark:bg-[#0A1419] text-white">
      <div class="shell py-16">
        <div class="grid grid-cols-2 gap-12 lg:gap-24">
          {/* Left Column */}
          <div class="flex flex-col items-start">
            <div class="mb-6">
              <Image src={logo} alt="SMG Digital Solutions" width={140} height={40} class="h-12 w-auto object-contain" />
            </div>
            <p class="mb-8 text-sm font-semibold text-white/90">SMG Digital Solutions</p>
            <div class="flex gap-4">
              <a href="https://www.instagram.com/smgdigital.solutions?igsh=bzdyYTYwZjNlN2l0" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-white/70 transition hover:text-[#4CAF50]">
                <InstagramLogo size={24} weight="fill" />
              </a>
              <a href="https://www.linkedin.com/company/smgdigitalsolutions/?viewAsMember=true" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-white/70 transition hover:text-[#4CAF50]">
                <LinkedinLogo size={24} weight="fill" />
              </a>
              <a href="https://www.facebook.com/share/1FoMrG2Zab/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-white/70 transition hover:text-[#4CAF50]">
                <FacebookLogo size={24} weight="fill" />
              </a>
            </div>
          </div>

          {/* Right Column */}
          <div class="flex flex-col items-end text-right">
            <nav class="mb-8 space-y-2">
              <a href="#services" class="block text-sm text-white/80 transition hover:text-[#4CAF50]">Services</a>
              <a href="#packages" class="block text-sm text-white/80 transition hover:text-[#4CAF50]">Pricing</a>
              <a href="#contact" class="block text-sm text-white/80 transition hover:text-[#4CAF50]">Contact</a>
            </nav>
            <div class="space-y-2 text-sm">
              <a href="tel:407-270-1023" class="block text-white/80 transition hover:text-[#4CAF50]">407-270-1023</a>
              <a href="mailto:hello@smgdigitalsolutions.com" class="block text-white/80 transition hover:text-[#4CAF50]">hello@smgdigitalsolutions.com</a>
            </div>
          </div>
        </div>

        {/* Bottom divider */}
        <div class="border-t border-white/10 mt-12 pt-6">
          <p class="text-xs text-white/50 text-center">© 2024 SMG Digital Solutions. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </div>
</Layout>
