---
import '../styles/global.css';
import logo from '../assets/Logo-Removed-Background.svg';
import { THEME_STORAGE_KEY } from '../lib/theme';
import { getSiteContent } from '../lib/content';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import SignupPopup from '../components/SignupPopup';

const {
  title = 'SMG Digital Solutions | High-Converting Websites for Florida & USVI',
  description = 'SMG Digital Solutions creates high-converting, high-performance websites for Florida and the U.S. Virgin Islands.',
} = Astro.props;

// Fetched independently from any page-level content fetch (index.astro does
// its own, larger one) so every page using this layout shows the sitewide
// announcement banner (and signup popup) without each page needing to
// remember to pass it down.
const { banners, signupForms } = await getSiteContent();

// Astro.site (set in astro.config.mjs) + the current path — a static build
// has no request context to infer the real origin from otherwise.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Only rendered when set (production, via netlify.toml) — local dev builds
// stay untracked so test traffic never lands in the real GA4 property.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SMG Digital Solutions',
  url: 'https://smgdigitalsolutions.com',
  logo: new URL(logo.src, Astro.site).toString(),
  description: 'SMG Digital Solutions creates high-converting, high-performance websites for Florida and the U.S. Virgin Islands.',
  telephone: '+1-407-270-1023',
  email: 'hello@smgdigitalsolutions.com',
  areaServed: ['Florida', 'U.S. Virgin Islands'],
  sameAs: [
    'https://www.instagram.com/smgdigital.solutions',
    'https://www.linkedin.com/company/smgdigitalsolutions/',
    'https://www.facebook.com/share/1FoMrG2Zab/',
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    {gaMeasurementId && (
      <>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Theme init: runs synchronously, before anything paints, so the site
      never flashes the wrong theme on load. Resolution order: an explicit
      choice the visitor already made via the toggle (localStorage) wins;
      otherwise follow the OS/browser's prefers-color-scheme live; otherwise
      default to light. ThemeToggle.tsx reads the class this script applies
      rather than re-deriving it, so there's exactly one place this logic
      lives. Wrapped in try/catch because localStorage can throw in some
      locked-down browser configurations (e.g. storage fully disabled).
    -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (function initTheme() {
        try {
          var stored = localStorage.getItem(THEME_STORAGE_KEY);
          var theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.classList.toggle('dark', theme === 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (error) {
          // Storage unavailable — fall back silently to the light default.
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00416A" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="dns-prefetch" href="https://instagram.com" />
    <link rel="dns-prefetch" href="https://linkedin.com" />
    <link rel="dns-prefetch" href="https://facebook.com" />
    <link rel="preload" as="font" href="https://rsms.me/inter/inter.css" crossorigin />
    <style>
      @supports (font-display: swap) {
        @font-face {
          font-family: Inter;
          font-display: swap;
        }
      }
    </style>
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#F7F7F7] text-[#121212] antialiased transition-colors duration-200 dark:bg-[#121212] dark:text-[#F7F7F7]">
    <!--
      Skip link (WCAG 2.4.1 Bypass Blocks): lets keyboard and screen reader
      users jump straight past the repeated header/nav to the page's main
      content. Visually hidden until it receives keyboard focus (the first
      Tab press on the page), per the standard "sr-only until focused"
      pattern — it never appears for mouse users.
    -->
    <a
      href="#main-content"
      class="sr-only z-[100] rounded-full bg-[#008C9E] px-5 py-3 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4 dark:bg-[#4CAF50]"
    >
      Skip to main content
    </a>
    <AnnouncementBanner banner={banners.announcement} />
    <SignupPopup client:idle form={signupForms.popup} />
    <slot />
    <!--
      Pageview + CTA-click tracking for the admin app's Analytics dashboard.
      A regular module script (not is:inline) so it goes through Vite and
      can read PUBLIC_ADMIN_ORIGIN — see src/scripts/tracking.ts.
    -->
    <script src="../scripts/tracking.ts"></script>
  </body>
</html>
