---
import '../styles/global.css';
import logo from '../assets/Logo-Removed-Background.svg';
import { THEME_STORAGE_KEY } from '../lib/theme';

const {
  title = 'SMG Digital Solutions | High-Converting Websites for Florida & USVI',
  description = 'SMG Digital Solutions creates high-converting, high-performance websites for Florida and the U.S. Virgin Islands.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Theme init: runs synchronously, before anything paints, so the site
      never flashes the wrong theme on load. Resolution order: an explicit
      choice the visitor already made via the toggle (localStorage) wins;
      otherwise follow the OS/browser's prefers-color-scheme live; otherwise
      default to light. ThemeToggle.tsx reads the class this script applies
      rather than re-deriving it, so there's exactly one place this logic
      lives. Wrapped in try/catch because localStorage can throw in some
      locked-down browser configurations (e.g. storage fully disabled).
    -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (function initTheme() {
        try {
          var stored = localStorage.getItem(THEME_STORAGE_KEY);
          var theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.classList.toggle('dark', theme === 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (error) {
          // Storage unavailable — fall back silently to the light default.
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00416A" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="preconnect" href="https://tally.so" />
    <link rel="preconnect" href="https://formsubmit.co" />
    <link rel="dns-prefetch" href="https://instagram.com" />
    <link rel="dns-prefetch" href="https://linkedin.com" />
    <link rel="dns-prefetch" href="https://facebook.com" />
    <link rel="preload" as="font" href="https://rsms.me/inter/inter.css" crossorigin />
    <style>
      @supports (font-display: swap) {
        @font-face {
          font-family: Inter;
          font-display: swap;
        }
      }
    </style>
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#F7F7F7] text-[#121212] antialiased transition-colors duration-200 dark:bg-[#121212] dark:text-[#F7F7F7]">
    <!--
      Skip link (WCAG 2.4.1 Bypass Blocks): lets keyboard and screen reader
      users jump straight past the repeated header/nav to the page's main
      content. Visually hidden until it receives keyboard focus (the first
      Tab press on the page), per the standard "sr-only until focused"
      pattern — it never appears for mouse users.
    -->
    <a
      href="#main-content"
      class="sr-only z-[100] rounded-full bg-[#008C9E] px-5 py-3 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4 dark:bg-[#4CAF50]"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
