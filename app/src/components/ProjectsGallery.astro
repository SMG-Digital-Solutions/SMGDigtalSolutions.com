---
import ScrollRevealStagger from './ScrollRevealStagger';
import ProjectsCarousel from './ProjectsCarousel';

const projects = [
  {
    title: 'Handyman Service Demo Website',
    type: 'Website Case Study',
    image: '/images/projects/handyman-demo-hero.png',
    imageAlt: 'Hero section screenshot of the Handyman Service demo website',
    summary:
      'A conversion-first website concept for a local handyman brand, designed to build trust quickly and drive quote requests with clear service messaging.',
    highlights: ['High-contrast service-focused hero', 'Trust signals above the fold', 'Mobile-first CTA structure'],
    stack: [
      'Next.js 16',
      'React 19',
      'TypeScript',
      'Tailwind CSS 4',
      'Framer Motion',
      'Vitest + Testing Library',
      'ESLint (Next.js)',
      '@phosphor-icons/react',
      'jsdom',
      'PostCSS'
    ],
    liveUrl: 'https://smghandymandemo.netlify.app/'
  },
  {
    title: "Dawn's Beauty Studio Demo Website",
    type: 'Website Case Study',
    image: '/images/projects/dawns-beauty-hero.png',
    imageAlt: "Hero section screenshot of the Dawn's Beauty hair, skin, and nail studio demo website",
    summary:
      'An editorial, image-forward concept for a New York hair, skin, and nail studio, built to feel upscale while keeping booking front and center.',
    highlights: ['Elegant serif hero typography', 'Full-bleed lifestyle photography', 'Prominent booking CTA above the fold'],
    stack: ['React', 'Vite', 'Tailwind CSS 4'],
    liveUrl: 'https://chic-starlight-a2551f.netlify.app/'
  },
  {
    title: 'Drywall & Texturing Contractor Demo Website',
    type: 'Website Case Study',
    image: '/images/projects/drywall-demo-hero.png',
    imageAlt: 'Hero section screenshot of the DNA Texturing & Drywall of Orlando demo website',
    summary:
      'A conversion-focused site for a Central Florida drywall and texturing company, pairing bold headline messaging with trust signals and reviews to drive free-estimate requests.',
    highlights: ['Bold high-contrast hero headline', 'Google rating and review count above the fold', 'Dual "Free Estimate" and "Call Now" CTAs'],
    stack: ['Next.js', 'React', 'Tailwind CSS 4'],
    liveUrl: 'https://drywall-demo.netlify.app/'
  },
  {
    title: 'Painting Contractor Demo Website',
    type: 'Website Case Study',
    image: '/images/projects/painting-demo-hero.png',
    imageAlt: 'Hero section screenshot of the Mike Jones Painting LLC demo website',
    summary:
      'A trust-building site for a veteran painting and drywall contractor in South Carolina, using licensing badges and a 5-star rating to reinforce credibility and drive quote requests.',
    highlights: ['Full-bleed project photography hero', 'Licensed & insured and 5-star rating badges', 'Layered "Get a Free Quote" and click-to-call CTAs'],
    stack: ['Next.js', 'React', 'Tailwind CSS 4'],
    liveUrl: 'https://painting-demo-site.netlify.app/'
  }
];
---

<section id="projects" class="shell py-8" aria-labelledby="projects-heading">
  <div class="rounded-[2rem] border border-black/10 bg-white/80 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-[#1A2B3C]/70">
    <div class="mb-8 max-w-4xl space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#008C9E] dark:text-[#4CAF50]">Project gallery</p>
      <h2 id="projects-heading" class="text-xl font-black leading-[1.15] tracking-tight text-[#121212] dark:text-[#F7F7F7] md:text-[1.65rem] lg:text-[1.8rem]">Recent Case Studies and Web Builds</h2>
      <p class="max-w-3xl text-base leading-7 text-[#4b5563] dark:text-[#d5dde4]">Explore examples of strategic websites built to improve brand credibility, conversion clarity, and customer action.</p>
    </div>

    <ScrollRevealStagger client:visible staggerDelay={100} threshold={0.15}>
      <ProjectsCarousel client:visible projects={projects} intervalMs={6000} />
    </ScrollRevealStagger>
  </div>
</section>