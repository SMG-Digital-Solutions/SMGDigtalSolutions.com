---
/**
 * Site-wide footer. Extracted to its own component so it renders
 * identically on every page (previously it only existed inline on the
 * homepage, which would have meant reimplementing it — and risking drift —
 * for the accessibility statement page).
 *
 * Internal links use an absolute `/#section` form (not a bare `#section`)
 * specifically so they resolve correctly from any page, not just `/`.
 */
import { Image } from 'astro:assets';
import { InstagramLogo, LinkedinLogo, FacebookLogo } from '@phosphor-icons/react';
import logo from '../assets/Logo-Removed-Background.svg';
---

<footer class="bg-[#0A1419] dark:bg-[#0A1419] text-white">
  <div class="shell py-16">
    <div class="grid grid-cols-2 gap-12 lg:gap-24">
      {/* Left Column */}
      <div class="flex flex-col items-start">
        <div class="mb-6">
          <Image src={logo} alt="SMG Digital Solutions" width={140} height={40} class="h-12 w-auto object-contain" />
        </div>
        <p class="mb-8 text-sm font-semibold text-white/90">SMG Digital Solutions</p>
        <div class="flex gap-4">
          <a href="https://www.instagram.com/smgdigital.solutions?igsh=bzdyYTYwZjNlN2l0" target="_blank" rel="noopener noreferrer" aria-label="Instagram (opens in a new tab)" class="text-white/70 transition hover:text-[#4CAF50]">
            <InstagramLogo size={24} weight="fill" aria-hidden="true" />
          </a>
          <a href="https://www.linkedin.com/company/smgdigitalsolutions/?viewAsMember=true" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)" class="text-white/70 transition hover:text-[#4CAF50]">
            <LinkedinLogo size={24} weight="fill" aria-hidden="true" />
          </a>
          <a href="https://www.facebook.com/share/1FoMrG2Zab/" target="_blank" rel="noopener noreferrer" aria-label="Facebook (opens in a new tab)" class="text-white/70 transition hover:text-[#4CAF50]">
            <FacebookLogo size={24} weight="fill" aria-hidden="true" />
          </a>
        </div>
      </div>

      {/* Right Column */}
      <div class="flex flex-col items-end text-right">
        <nav class="mb-8 space-y-2" aria-label="Footer">
          <a href="/#services" class="block text-sm text-white/80 transition hover:text-[#4CAF50]">Services</a>
          <a href="/#packages" class="block text-sm text-white/80 transition hover:text-[#4CAF50]">Pricing</a>
          <a href="/#contact" class="block text-sm text-white/80 transition hover:text-[#4CAF50]">Contact</a>
        </nav>
        <div class="space-y-2 text-sm">
          <a href="tel:407-270-1023" class="block text-white/80 transition hover:text-[#4CAF50]">407-270-1023</a>
          <a href="mailto:hello@smgdigitalsolutions.com" class="block text-white/80 transition hover:text-[#4CAF50]">hello@smgdigitalsolutions.com</a>
        </div>
      </div>
    </div>

    {/* Bottom divider */}
    <div class="mt-12 flex flex-col items-center gap-3 border-t border-white/10 pt-6 sm:flex-row sm:justify-between">
      <p class="text-xs text-white/50">© {new Date().getFullYear()} SMG Digital Solutions. All rights reserved.</p>
      <a href="/accessibility" class="text-xs text-white/50 underline-offset-4 transition hover:text-[#4CAF50] hover:underline">
        Accessibility Statement
      </a>
    </div>
  </div>
</footer>
