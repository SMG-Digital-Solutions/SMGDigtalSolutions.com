---
import PricingPlans from './PricingPlans.tsx';
import InteractiveQuoteCalculator from './InteractiveQuoteCalculator.tsx';
import AddOnsSection from './AddOnsSection.tsx';
---

<section id="packages" class="shell py-8" aria-labelledby="packages-heading">
  <div class="mb-10 rounded-[2rem] bg-[#00416A] p-8 text-center shadow-sm dark:bg-[#072938] sm:p-10">
    <p class="mx-auto max-w-3xl text-lg font-semibold leading-8 text-white sm:text-xl">
      Traditional agencies charge $5,000 to $60,000 for a custom web build. We don&rsquo;t. Get an
      enterprise-grade, high-converting website engineered for speed&mdash;without the bloated agency price tag.
    </p>
  </div>

  <div class="mb-6">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#008C9E] dark:text-[#4CAF50]">Service Tier & Pricing</p>
    <h2 id="packages-heading" class="mt-2 text-3xl font-black">Pricing and Packages</h2>
  </div>

  <PricingPlans client:visible />

  <div class="mt-14">
    <AddOnsSection client:visible />
  </div>

  <div class="mt-14">
    <InteractiveQuoteCalculator client:visible />
  </div>
</section>
